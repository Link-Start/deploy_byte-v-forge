# Host ports.
WEBUI_PORT=8080
WEBHOOK_PORT=8081
POSTGRES_PORT=5432
PLATFORM_NATS_PORT=4222
PLATFORM_NATS_MONITOR_PORT=8222
N8N_EDITOR_PORT=5678
BROWSER_AUTOMATION_GRPC_PORT=50062
MAILBOX_GRPC_PORT=50058
GPT_ACCOUNT_GRPC_PORT=50052
GPT_SERVICE_GRPC_PORT=50055
SMS_SERVICE_GRPC_PORT=50061
WA_APP_GRPC_PORT=50091
WA_APP_DATA_DIR=/var/lib/wa-app
PROXY_RUNTIME_GATEWAY_PORT=30081
# Core storage, semantic Redis stores, and n8n.
POSTGRES_USER=byte_v_forge
POSTGRES_PASSWORD=byte_v_forge
POSTGRES_DB=byte_v_forge
PLATFORM_REDIS_URL=redis://platform-redis:6379/0
PLATFORM_NATS_URL=nats://platform-nats:4222
PLATFORM_EVENT_STREAM_NAME=BYTE_V_FORGE_EVENTS
SMS_PG_DSN=
SMS_REDIS_URL=
SMS_NATS_URL=
SMS_EVENT_STREAM_NAME=BYTE_V_FORGE_EVENTS
MAILBOX_PG_DSN=
MAILBOX_COORDINATION_REDIS_URL=
MAILBOX_RECENT_EMAIL_REDIS_URL=
MAILBOX_NATS_URL=
MAILBOX_EVENT_STREAM_NAME=BYTE_V_FORGE_EVENTS
MAILBOX_BROWSER_AUTOMATION_ADDR=
GPT_RUNTIME_SECRET_KEY_PREFIX=byte-v-forge:gpt:runtime-secrets
GPT_RUNTIME_SECRET_TTL_SECONDS=86400
GOPAY_STATE_KEY_PREFIX=byte-v-forge:gopay-app:state
GOPAY_STATE_TTL_SECONDS=604800
MAILBOX_RECENT_EMAIL_CACHE_KEY_PREFIX=mailbox:recent-email
MAILBOX_RECENT_EMAIL_CACHE_TTL_SECONDS=3600
MAILBOX_RECENT_EMAIL_CACHE_MAX_MESSAGES=20
MAILBOX_INBOX_LOCK_KEY_PREFIX=mailbox:locks
MAILBOX_INBOX_LOCK_TTL_SECONDS=600
MAILBOX_INBOX_LOCK_RETRY_SECONDS=1
# Create the n8n public API key in n8n UI, then paste it here.
N8N_PUBLIC_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:8081/
N8N_ENCRYPTION_KEY=byte_v_forge_n8n_encryption_key_change_me_32
N8N_RUNNERS_AUTH_TOKEN=byte_v_forge_n8n_runner_auth_token_change_me_32
N8N_POSTGRES_PASSWORD=byte_v_forge_n8n
N8N_API_KEY=
N8N_INSTANCE_OWNER_EMAIL=byte-v-forge@byte-v-forge.local
N8N_INSTANCE_OWNER_PASSWORD_HASH=$2b$10$j6/JtPvAKtGGGMVOTqIQrOaq3b0.fQyK46ZWQdNN4E4e496n5ToYq
GPT_N8N_WEBHOOK_BASE_URL=http://n8n-webhook:5678/webhook
WA_N8N_WEBHOOK_BASE_URL=http://n8n-webhook:5678/webhook
GOPAY_N8N_WEBHOOK_BASE_URL=http://n8n-webhook:5678/webhook
GPT_ACTION_API_BASE_URL=http://gpt-service:8080/api/gpt/actions
GOPAY_ACTION_API_BASE_URL=http://gopay-app:8080/api/gopay/actions
GOPAY_OTP_SUBMIT_URL=http://gopay-app:8080/api/gopay/otp/submit
GOPAY_HTTP_LISTEN_ADDR=:8080
GOPAY_DASHBOARD_STATIC_DIR=/app/dashboard/gopay
WA_ACTION_API_BASE_URL=http://wa-app-service:8080/api/wa/actions
PROXY_RUNTIME_API_BASE_URL=http://proxy-runtime:8080/api
WA_LONG_CONNECTION_PROXY_USERNAME=whatsapp
WA_NUMBER_PROBE_PROXY_USERNAME=whatsapp-probe
WA_REGISTRATION_PROXY_USERNAME=whatsapp-reg
WA_ACCOUNT_SETTINGS_PROXY_USERNAME=whatsapp-reg
WA_LOGIN_STATE_CHECK_PROXY_USERNAME=whatsapp-reg
WORKFLOW_RUNTIME_API_BASE_URL=http://workflow-runtime:8080/api/workflow-runtime
WORKFLOW_RUNTIME_STEP_UPDATE_TOKEN=byte_v_forge_workflow_runtime_step_update_token_change_me_32
PROXY_RUNTIME_MIHOMO_API_ADDR=127.0.0.1:18901
PROXY_RUNTIME_DATA_DIR=/var/lib/proxy-runtime
PROXY_RUNTIME_REDIS_URL=redis://platform-redis:6379/0
PROXY_RUNTIME_LOCAL_ADDR=:10810
