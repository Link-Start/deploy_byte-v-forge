# Host ports.
WEBUI_PORT=8080
WEBHOOK_PORT=8081
POSTGRES_PORT=5432
PLATFORM_NATS_PORT=4222
PLATFORM_NATS_MONITOR_PORT=8222
N8N_EDITOR_PORT=5678
BROWSER_AUTOMATION_GRPC_PORT=50062
BROWSER_AUTOMATION_HTTP_PORT=50063
MAILBOX_GRPC_PORT=50058
GPT_ACCOUNT_GRPC_PORT=50052
GPT_SERVICE_GRPC_PORT=50055
SMS_SERVICE_GRPC_PORT=50061
WA_APP_GRPC_PORT=50091
WA_APP_AUTH_PASSWORD=
WA_APP_DATA_DIR=/var/lib/wa-app
WA_APP_PG_DSN=
WA_APP_REDIS_URL=
WA_COMMON_PROXY=
PROXY_RUNTIME_GATEWAY_PORT=30081
# Core storage, semantic Redis stores, and n8n.
POSTGRES_USER=byte_v_forge
POSTGRES_PASSWORD=byte_v_forge
POSTGRES_DB=byte_v_forge
PLATFORM_REDIS_URL=redis://platform-redis:6379/0
PLATFORM_NATS_URL=nats://platform-nats:4222
PLATFORM_EVENT_STREAM_NAME=BYTE_V_FORGE_EVENTS
SMS_PG_DSN=host=postgres user=byte_v_forge password=byte_v_forge dbname=byte_v_forge port=5432 sslmode=disable
SMS_REDIS_URL=redis://platform-redis:6379/0
SMS_NATS_URL=nats://platform-nats:4222
SMS_EVENT_STREAM_NAME=BYTE_V_FORGE_EVENTS
MAILBOX_PG_DSN=host=postgres user=byte_v_forge password=byte_v_forge dbname=byte_v_forge port=5432 sslmode=disable
MAILBOX_COORDINATION_REDIS_URL=redis://platform-redis:6379/0
MAILBOX_RECENT_EMAIL_REDIS_URL=redis://platform-redis:6379/0
MAILBOX_NATS_URL=nats://platform-nats:4222
MAILBOX_EVENT_STREAM_NAME=BYTE_V_FORGE_EVENTS
MAILBOX_BROWSER_AUTOMATION_ADDR=
GPT_RUNTIME_SECRET_KEY_PREFIX=byte-v-forge:gpt:runtime-secrets
GPT_RUNTIME_SECRET_TTL_SECONDS=86400
GOPAY_STATE_KEY_PREFIX=byte-v-forge:gopay-app:state
GOPAY_STATE_TTL_SECONDS=604800
MAILBOX_RECENT_EMAIL_CACHE_KEY_PREFIX=byte-v-forge:mailbox:recent-email
MAILBOX_RECENT_EMAIL_CACHE_TTL_SECONDS=3600
MAILBOX_RECENT_EMAIL_CACHE_MAX_MESSAGES=20
MAILBOX_INBOX_LOCK_KEY_PREFIX=byte-v-forge:mailbox:locks
MAILBOX_INBOX_LOCK_TTL_SECONDS=600
MAILBOX_INBOX_LOCK_RETRY_SECONDS=1
# Create the n8n public API key in n8n UI, then paste it here.
N8N_PUBLIC_URL=http://localhost:5678
WEBHOOK_URL=http://localhost:8081/
N8N_ENCRYPTION_KEY=byte_v_forge_n8n_encryption_key_change_me_32
N8N_RUNNERS_AUTH_TOKEN=byte_v_forge_n8n_runner_auth_token_change_me_32
N8N_POSTGRES_PASSWORD=byte_v_forge_n8n
N8N_API_KEY=
N8N_INSTANCE_OWNER_EMAIL=byte-v-forge@byte-v-forge.local
N8N_INSTANCE_OWNER_PASSWORD_HASH=$2b$10$j6/JtPvAKtGGGMVOTqIQrOaq3b0.fQyK46ZWQdNN4E4e496n5ToYq
GPT_N8N_WEBHOOK_BASE_URL=http://n8n-webhook:5678/webhook
GOPAY_N8N_WEBHOOK_BASE_URL=http://n8n-webhook:5678/webhook
GPT_ACTION_API_BASE_URL=http://gpt-service:8080/api/gpt/actions
GOPAY_ACTION_API_BASE_URL=http://gopay-app:8080/api/gopay/actions
GOPAY_OTP_SUBMIT_URL=http://gopay-app:8080/api/gopay/otp/submit
GOPAY_HTTP_LISTEN_ADDR=:8080
GOPAY_DASHBOARD_STATIC_DIR=/app/dashboard/gopay
WA_ACTION_API_BASE_URL=http://wa-app-service:8080/api/wa/actions
PROXY_RUNTIME_API_BASE_URL=http://proxy-runtime:8080/api
WORKFLOW_RUNTIME_API_BASE_URL=http://workflow-runtime:8080/api/workflow-runtime
WORKFLOW_RUNTIME_STEP_UPDATE_TOKEN=byte_v_forge_workflow_runtime_step_update_token_change_me_32
PROXY_RUNTIME_MIHOMO_API_ADDR=127.0.0.1:18901
PROXY_RUNTIME_DATA_DIR=/var/lib/proxy-runtime
PROXY_RUNTIME_REDIS_URL=redis://platform-redis:6379/0
PROXY_RUNTIME_LOCAL_ADDR=:10810
PROXY_RUNTIME_LOCAL_PROTOCOL=socks5
PROXY_RUNTIME_ENCRYPTION_KEY=byte_v_forge_proxy_runtime_encryption_key_change_me_32
PROXY_RUNTIME_SESSION_ADVERTISED_HOST=proxy-runtime
SMS_PROVIDER_HTTP_PROXY=socks5://sms:sms@proxy-runtime:10810

# OpenAI SSO Lite.
OPENAI_SSO_LITE_HTTP_PORT=8091
OPENAI_SSO_LITE_ISSUER=https://sso.example.invalid
OPENAI_SSO_LITE_ALLOWED_REDIRECT_URI_PREFIXES=https://external.auth.openai.com/
OPENAI_SSO_LITE_CLIENT_SECRET=change-me-at-least-32-characters
OPENAI_SSO_LITE_ADMIN_TOKEN=change-me-at-least-32-characters
OPENAI_SSO_LITE_RSA_PRIVATE_KEY_B64=

# OpenAI SSO Discord bot.
OPENAI_SSO_DISCORD_BOT_HTTP_PORT=8092
OPENAI_SSO_DISCORD_BOT_TOKEN=
OPENAI_SSO_DISCORD_BOT_APPLICATION_ID=
OPENAI_SSO_DISCORD_BOT_GUILD_ID=
OPENAI_SSO_DISCORD_BOT_DEFAULT_CLAIM_LIMIT=1
OPENAI_SSO_DISCORD_BOT_EMAIL_DOMAIN=workspace.example.invalid
OPENAI_SSO_DISCORD_BOT_PROXY_URL=socks5://proxy-runtime:10810

# Browser automation.
BROWSER_AUTOMATION_APPLY_MIGRATIONS=true
BROWSER_AUTOMATION_RUNTIME=camoufox
BROWSER_AUTOMATION_MAX_CONCURRENT_SESSIONS=0
BROWSER_AUTOMATION_WEBRTC_TCP_BIND=127.0.0.1
BROWSER_AUTOMATION_WEBRTC_TCP_PORT=3479
BROWSER_AUTOMATION_WEBRTC_UDP_BIND=127.0.0.1
BROWSER_AUTOMATION_WEBRTC_UDP_PORT=3478
BROWSER_AUTOMATION_WEBRTC_PUBLIC_IPS=127.0.0.1
BROWSER_AUTOMATION_PROXY_REFS_JSON={"register":"socks5://host.docker.internal:10813","outlook":"socks5://host.docker.internal:10810"}
BROWSER_AUTOMATION_PROXY_RUNTIME_BASE_URL=http://proxy-runtime:8080/api
BROWSER_AUTOMATION_PROXY_RUNTIME_TIMEOUT_SECONDS=10
BROWSER_AUTOMATION_PROXY_RUNTIME_ACCOUNT_ID=
BROWSER_AUTOMATION_PROXY_RUNTIME_PURPOSE=browser-automation
BROWSER_FETCH_PROXY=http://host.docker.internal:10809

